{
  "name": "college-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "db:migrate:remote": "wrangler d1 execute repo-dashboard-work-items --remote --file",
    "db:migrate:local": "wrangler d1 execute repo-dashboard-work-items --local --file",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
